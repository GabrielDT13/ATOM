# ======================================
# ATOM
# ======================================
ATOM_PORT=8080
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ======================================
# SUPABASE - ACCESS FROM atom-app
# ======================================
SUPABASE_URL_INTERNAL=http://supabase-kong:8000
SUPABASE_ANON_KEY=replace_with_your_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key

# ======================================
# SUPABASE - NETWORK / PORTS (HOST)
# ======================================
SUPABASE_PORT=54321
SUPABASE_DB_PORT=54322
SUPABASE_STUDIO_PORT=54323

# ======================================
# SUPABASE - DATABASE
# ======================================
SUPABASE_DB_USER=postgres
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PASSWORD=postgres

# ======================================
# SUPABASE - AUTH / JWT
# ======================================
JWT_SECRET=replace_with_a_secret_of_at_least_32_characters
SUPABASE_API_EXTERNAL_URL=http://127.0.0.1:54321
SUPABASE_SITE_URL=http://127.0.0.1:8080
SUPABASE_DISABLE_SIGNUP=false
SUPABASE_JWT_AUD=authenticated
SUPABASE_JWT_EXP=3600

# ======================================
# SUPABASE - DIFF / MIGRATIONS
# ======================================
SUPABASE_DIFF_SCHEMAS=public,auth
