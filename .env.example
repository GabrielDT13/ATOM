# ======================================
# APP - HOST PORTS
# ======================================
ATOM_PORT=3000
ATOM_API_PORT=8000

# ======================================
# BACKEND - RUNTIME
# ======================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
SESSION_SECRET=change-this-in-production
FRONTEND_URL=http://localhost:3000

# Optional overrides for local testing or alternative layouts.
# ATOM_PROJECT_ROOT=/absolute/path/to/ATOM
# ATOM_DATA_DIR=/absolute/path/to/data
# ATOM_PROJECTS_DIR=/absolute/path/to/projects
# ATOM_R_SCRIPTS_DIR=/absolute/path/to/r_scripts

# ======================================
# FRONTEND - API ACCESS
# ======================================
NEXT_PUBLIC_API_BASE_URL=/backend-api
BACKEND_INTERNAL_URL=http://atom-backend:8000
NEXT_PUBLIC_BACKEND_PUBLIC_ORIGIN=
NEXT_PUBLIC_BACKEND_PUBLIC_PORT=8000

# ======================================
# SUPABASE - ACCESS FROM BACKEND
# ======================================
SUPABASE_URL_INTERNAL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=replace_with_your_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key

# ======================================
# SUPABASE - NETWORK / PORTS (HOST)
# ======================================
SUPABASE_PORT=54321
SUPABASE_DB_PORT=54322

# ======================================
# SUPABASE - DATABASE
# ======================================
SUPABASE_DB_USER=postgres
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PASSWORD=postgres

# ======================================
# SUPABASE - AUTH / JWT
# ======================================
JWT_SECRET=replace_with_a_secret_of_at_least_32_characters
SUPABASE_API_EXTERNAL_URL=http://127.0.0.1:54321
SUPABASE_SITE_URL=http://127.0.0.1:3000
SUPABASE_DISABLE_SIGNUP=false
SUPABASE_JWT_AUD=authenticated
SUPABASE_JWT_EXP=3600

# ======================================
# SUPABASE - DIFF / MIGRATIONS
# ======================================
SUPABASE_DB_SCHEMAS=public
SUPABASE_DIFF_SCHEMAS=public,internal,app_private,auth
