# ======================================
# APP - HOST PORTS
# ======================================
ATOM_PORT=3000
ATOM_API_PORT=8000

# ======================================
# BACKEND - RUNTIME
# ======================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
ATOM_BACKEND_BUILD_TARGET=backend-base
SESSION_SECRET=change-this-in-production
FRONTEND_URL=http://localhost:3000

# Optional overrides for local testing or alternative layouts.
# ATOM_PROJECT_ROOT=/absolute/path/to/ATOM
# ATOM_DATA_DIR=/absolute/path/to/data
# ATOM_PROJECTS_DIR=/absolute/path/to/projects
# ATOM_R_SCRIPTS_DIR=/absolute/path/to/r_scripts

# ======================================
# FRONTEND - API ACCESS
# ======================================
NEXT_PUBLIC_API_BASE_URL=/backend-api
BACKEND_INTERNAL_URL=http://atom-backend:8000
NEXT_PUBLIC_BACKEND_PUBLIC_ORIGIN=
NEXT_PUBLIC_BACKEND_PUBLIC_PORT=8000

# ======================================
# POSTGRESQL - DIRECT ACCESS
# ======================================
DATABASE_URL=
POSTGRES_HOST=atom-db
POSTGRES_PORT=5432
POSTGRES_PORT_HOST=5432
POSTGRES_DB=atom
POSTGRES_USER=atom
POSTGRES_PASSWORD=atom
JWT_AUDIENCE=authenticated
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000

# ======================================
# AUTH / JWT
# ======================================
JWT_SECRET=replace_with_a_secret_of_at_least_32_characters
